# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Get your key from Google AI Studio or configure it via Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
APP_URL="http://localhost:3000"

# PORT: Port for the Express + Vite server (default: 3000).
PORT="3000"
